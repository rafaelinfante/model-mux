# Copy to .env and fill in to enable the real providers. With no keys the gateway
# runs entirely on the built-in mock providers, so `docker compose up` works as-is.

# --- Anthropic ---
MODELMUX_ANTHROPIC_ENABLED=false
MODELMUX_ANTHROPIC_API_KEY=
MODELMUX_ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI ---
MODELMUX_OPENAI_ENABLED=false
MODELMUX_OPENAI_API_KEY=
MODELMUX_OPENAI_MODEL=gpt-4o-mini

# --- Database (compose sets these for you) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=modelmux
MYSQL_USER=modelmux
MYSQL_PASSWORD=modelmux
